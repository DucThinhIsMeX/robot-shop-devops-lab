# File sinh tự động bởi Terraform, không sửa tay.

[edge]
edge ansible_host=${edge_public_ip}

[masters]
%{ for name, ip in masters ~}
${name} ansible_host=${ip}
%{ endfor ~}

[workers]
%{ for name, ip in workers ~}
${name} ansible_host=${ip}
%{ endfor ~}

[k8s_cluster:children]
masters
workers

[all:vars]
ansible_user=${ssh_user}
ansible_ssh_private_key_file=${ssh_key_path}

[k8s_cluster:vars]
ansible_ssh_common_args='-o ProxyJump=${ssh_user}@${edge_public_ip} -o StrictHostKeyChecking=accept-new'
